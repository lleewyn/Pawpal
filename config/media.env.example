# Server-only template. Copy into a private environment file or Vercel Environment Variables.
# Do not commit the populated file. Do not paste the real URI into chat.
# Atlas connection string from Connect > Drivers; percent-encode special password characters.
PAWPAL_MEDIA_MONGODB_URI=mongodb+srv://DATABASE_USER:ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
PAWPAL_MEDIA_MONGODB_DB=pawpal_media
PAWPAL_MEDIA_MONGODB_BUCKET=pawpalMedia
PAWPAL_MEDIA_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PAWPAL_MEDIA_SUPABASE_ANON_KEY=YOUR_ANON_KEY
PAWPAL_MEDIA_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Optional comma-separated exact browser origins; same-host requests work without this.
MEDIA_ALLOWED_ORIGINS=

# Keep disabled until schema, permissions, upload verification and UI are implemented.
MEDIA_UPLOAD_ENABLED=false
MEDIA_VIDEO_ENABLED=false
